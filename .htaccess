# MKN ARABIA — Hostinger (LiteSpeed/Apache)
Options -Indexes
ErrorDocument 404 /404.html
ErrorDocument 403 /404.html

# Force HTTPS and the non-www domain
RewriteEngine On
RewriteCond %{HTTPS} !=on
RewriteRule ^ https://mknarabia.com%{REQUEST_URI} [L,R=301]
RewriteCond %{HTTP_HOST} ^www\.mknarabia\.com$ [NC]
RewriteRule ^ https://mknarabia.com%{REQUEST_URI} [L,R=301]

# One URL for the home page, and a friendly folder URL for the articles
RewriteCond %{THE_REQUEST} \s/index\.html[\s?]
RewriteRule ^index\.html$ / [R=301,L]
RewriteRule ^insights/?$ /insights.html [R=301,L]

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript image/svg+xml application/xml text/plain
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 hour"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType image/webp "access plus 6 months"
  ExpiresByType image/png "access plus 6 months"
  ExpiresByType image/jpeg "access plus 6 months"
</IfModule>

AddType font/woff2 .woff2

# CSS/JS links carry a ?v=<hash> that changes with every edit, so they can be cached for a long time
<IfModule mod_headers.c>
  <FilesMatch "\.(css|js|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Security headers
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Keep source/docs out of public reach
<FilesMatch "\.(md|R|py)$">
  Require all denied
</FilesMatch>
RedirectMatch 404 /\.git
